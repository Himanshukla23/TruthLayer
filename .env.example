# TruthLayer Environment Configuration Template
# Copy this file to .env for local development
# NEVER commit the actual .env file with real keys to source control

# Google Gemini API Key for claim extraction & verification reasoning (Primary)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key for LLM fallback when Gemini quota/rate limits are exceeded
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API Key for live web evidence retrieval
TAVILY_API_KEY=your_tavily_api_key_here

# Application Environment (development, staging, production)
APP_ENV=development

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Port (default: 8501)  
PORT=8501

# Maximum Upload File Size in Megabytes (MVP default: 20 MB)
MAX_UPLOAD_SIZE_MB=20

# Maximum PDF Pages to Process in MVP (MVP default: 10)
MAX_PDF_PAGES=10
